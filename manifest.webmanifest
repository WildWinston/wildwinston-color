{
  "name": "Color Time",
  "short_name": "Color Time",
  "description": "A free coloring book for kids — no ads, works offline",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#FFF5FB",
  "theme_color": "#FF69B4",
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "data:image/png;base64,",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "data:image/png;base64,",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
